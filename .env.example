# ===== MCP / 高德配置 =====
# 是否使用真实高德 API（false=走 mock，离线可跑；true=切真实，仅改这里）
AMAP_REAL_MODE=false
# 真实高德 key（AMAP_REAL_MODE=true 时必填）
AMAP_API_KEY=
# 高德开放平台 base url（一般无需改动）
AMAP_BASE_URL=https://restapi.amap.com/v3

# ===== 客户端 =====
# 传输方式：direct（进程内直连，评测/测试用）| stdio（拉起真实 MCP server）
MCP_TRANSPORT=direct

# ===== 超时与重试 =====
REQUEST_TIMEOUT=10.0
MAX_RETRIES=3

# ===== LLM（OpenAI 兼容，DeepSeek 填 OPENAI_BASE_URL=https://api.deepseek.com/v1）=====
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL=gpt-4o-mini

# ===== API 层 =====
# Checkpointer sqlite 路径（不填走项目根目录 checkpoints.sqlite）
TRAVEL_PLANNER_DB=
